# Copie estes valores para as variáveis de ambiente do recurso no Coolify.
# AGENTES_ORG: UUID da organização, extraído da URL agentes.chat/org/<UUID>/...
AGENTES_ORG=00000000-0000-0000-0000-000000000000

# Nome MagicDNS da máquina Tailscale, sem barra final.
ESCRITORIO_BASE=https://nome-da-maquina.sua-tailnet.ts.net

# Endereço público do código-fonte do seu fork (AGPL-3.0-or-later).
ESCRITORIO_FONTE=https://github.com/learts13/escritorio-agentes

# Porta publicada somente no loopback da VPS; Tailscale Serve encaminha para ela.
COOLIFY_HOST_PORT=7372
